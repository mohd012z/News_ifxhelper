{
  "name": "xau-desk",
  "version": "1.1.0",
  "private": true,
  "description": "XAU//DESK - market news, speaker watch, evidence alignment and ATR context. Ships as a PWA and Android app via Capacitor.",
  "scripts": {
    "icons": "node make-icons.js",
    "atr": "node build-atr.js",
    "news": "node build-news.js",
    "macro": "node build-macro.js",
    "manifest:data": "node build-data-manifest.js",
    "refresh:data": "node build-news.js && node build-macro.js && node build-data-manifest.js",
    "test:evidence": "node test/evidence-engine.test.js",
    "test": "npm run test:evidence",
    "serve": "node tools/serve.js",
    "prepare-web": "node build-data-manifest.js && node tools/prepare-web.js",
    "cap:add": "npx cap add android",
    "cap:sync": "npm run prepare-web && npx cap sync android",
    "cap:open": "npx cap open android",
    "apk:debug": "cd android && gradlew.bat assembleDebug",
    "apk:release": "cd android && gradlew.bat assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0"
  }
}
