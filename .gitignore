# Dependencies
node_modules/

# Android build output (regenerate with npm run cap:sync / apk:debug)
android/app/build/
android/.gradle/
android/build/
android/local.properties
android/app/release/
*.apk
*.aab
*.keystore
*.jks

# Capacitor sync output (regenerated by prepare-web / cap:sync)
www/

# Note: .news-alert-state.json is intentionally NOT ignored — the daily bot workflow commits it
# so the next scheduled run knows what was already sent to Telegram (GitHub Actions runners are
# ephemeral; without a committed state file, every run would re-alert on the same events).

# Local env / secrets — never commit tokens
.env
.env.local

# OS / editor cruft
.DS_Store
Thumbs.db
